{
  "name": "pia",
  "version": "4.2.0",
  "license": "GPL-3.0-only",
  "author": "ATNOS",
  "repository": "https://github.com/LINCnil/pia",
  "description": "Version Portable Outil PIA",
  "main": "electron/main.js",
  "desktopName": "pia.desktop",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test pia-angular",
    "lint": "ng lint",
    "e2e": "cypress open --config watchForFileChanges=false --browser chrome",
    "prod": "ng build --configuration production",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "format:write": "prettier src/**/*.{ts,json,md,scss} --write",
    "format:test": "prettier src/**/*.{ts,json,md,scss} --list-different",
    "extract-i18n": "ngx-translate-extract --input src --output ./src/assets/i18n/ --clean --sort --format namespaced-json",
    "compodoc": "compodoc -p tsconfig.json",
    "electron:start": "electron .",
    "electron:mac": "electron-builder -m",
    "electron:win": "electron-builder -w",
    "electron:linux": "yarn electron:linux:packages && yarn electron:snap",
    "electron:linux:packages": "electron-builder --linux AppImage tar.gz --publish never",
    "electron:linux:x64": "yarn electron:linux:packages --x64 && yarn electron:snap --x64",
    "electron:linux:arm64": "yarn electron:linux:packages --arm64 && yarn electron:snap --arm64 --config.snapcraft.base=core24",
    "electron:linux:archives": "electron-builder --linux tar.gz --x64 --arm64 --publish never",
    "electron:snap": "electron-builder --linux snap --publish never --config.linux.executableName=privacy-impact-assessment",
    "electron:flatpak": "flatpak-builder --user --install --force-clean build-dir flatpak/fr.cnil.PIA.yml",
    "electron:publish-to-github": "electron-builder -mwl -p onTagOrDraft"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "private": true,
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular/animations": "^22.2.4",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@compodoc/compodoc": "^2.0.0",
    "@electron/notarize": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@ngx-translate/core": "^16",
    "@ngx-translate/http-loader": "^16",
    "@types/intro.js": "^2.4.8",
    "@types/jasmine": "~3.6.11",
    "@types/jasminewd2": "~2.0.10",
    "@types/node": "^22.18.6",
    "@vendure/ngx-translate-extract": "^10.3.2",
    "angular-eslint": "22.8.0",
    "cypress": "^15.3.0",
    "cypress-file-upload": "^4.1.1",
    "cypress-localstorage-commands": "^1.3.1",
    "d3": "^7.8.5",
    "dotenv": "^8.2.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^10.14.0",
    "file-saver": "^2.0.5",
    "foundation-sites": "^6.6.3",
    "html2canvas": "1.0.0",
    "husky": "^4.0.10",
    "intro.js": "^2.9.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.7.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~4.0.1",
    "karma-jasmine-html-reporter": "^1.5.4",
    "ng-packagr": "^22.2.6",
    "ng2-pdfjs-viewer": "^25.0.9",
    "ngx-chips": "3.0.0",
    "ngx-cypress-builder": "^1.0.2",
    "normalize.css": "^8.0.1",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.1.3",
    "rxjs": "^7.8.2",
    "sass": "^1.29.0",
    "save-svg-as-png": "^1.4.17",
    "tinymce": "^8.9.3",
    "ts-node": "~8.3.0",
    "tslib": "^2.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.2",
    "zone.js": "~0.15.0"
  },
  "build": {
    "appId": "com.atnos.pia",
    "afterSign": "electron/notarize.js",
    "files": [
      "dist/pia-angular/**/*",
      "electron/*.js",
      "electron/progress.html"
    ],
    "directories": {
      "buildResources": "electron/icons",
      "output": "electron/releases"
    },
    "publish": [
      "github"
    ],
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "electron/icons/icon.png",
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "category": "public.app.category.productivity",
      "target": {
        "target": "default",
        "arch": [
          "universal"
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.png"
    },
    "linux": {
      "category": "Office",
      "syncDesktopName": true,
      "extraFiles": [
        {
          "from": "flatpak/fr.cnil.PIA.desktop",
          "to": "fr.cnil.PIA.desktop"
        },
        {
          "from": "flatpak/fr.cnil.PIA.metainfo.xml",
          "to": "fr.cnil.PIA.metainfo.xml"
        },
        {
          "from": "electron/icons/icon.png",
          "to": "icon.png"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "snapcraft": {
      "base": "core22",
      "core24": {
        "useLXD": true
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "packageManager": "yarn@4.10.3"
}
