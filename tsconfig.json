{
  "compileOnSave": false,
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "strict": false,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "typeRoots": ["node_modules/@types"],
    "module": "es2020",
    "paths": {
      "src/*": ["./src/*"],
      "@atnos/pia-i18n/*": ["./projects/pia-i18n/*", "./projects/pia-i18n"],
      "@atnos/pia-i18n": ["./dist/pia-i18n/*", "./dist/pia-i18n"]
    },
    "useDefineForClassFields": false
  }
}
